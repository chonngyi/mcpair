<?xml version="1.0" encoding="UTF-8"?>
<gdml>
  <define>
    <position name="Origin" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <isotope name="Fe54" Z="26" N="54">
      <atom value="53.93960824563659" unit="g/mole"/>
    </isotope>
    <isotope name="Fe56" Z="26" N="56">
      <atom value="55.93493559573169" unit="g/mole"/>
    </isotope>
    <isotope name="Fe57" Z="26" N="57">
      <atom value="56.93539200978217" unit="g/mole"/>
    </isotope>
    <isotope name="Fe58" Z="26" N="58">
      <atom value="57.93327363582994" unit="g/mole"/>
    </isotope>
    <element name="NaturalIron" formula="Fe">
      <fraction n="0.05845" ref="Fe54"/>
      <fraction n="0.91754" ref="Fe56"/>
      <fraction n="0.02119" ref="Fe57"/>
      <fraction n="0.00282" ref="Fe58"/>
    </element>
    <material name="G4_Galactic" Z="1" state="gas">
      <T value="2.73" unit="K"/>
      <P value="3e-18" unit="pascal"/>
      <D value="1e-25" unit="g/cm3"/>
      <atom value="1.01" unit="g/mole"/>
    </material>
    <material name="TargetMaterial" state="solid">
      <T value="296" unit="K"/>
      <D value="7.874" unit="g/cm3"/>
      <fraction n="1" ref="NaturalIron"/>
    </material>
  </materials>
  <solids>
    <orb name="WorldSolid" r="50" lunit="cm"/>
    <tube name="TargetSolid" rmin="0" rmax="1.5" z="0.12700025400050802" startphi="0" deltaphi="360" aunit="deg" lunit="cm"/>
  </solids>
  <structure>
    <volume name="Target">
      <materialref ref="TargetMaterial"/>
      <solidref ref="TargetSolid"/>
    </volume>
    <volume name="World">
      <materialref ref="G4_Galactic"/>
      <solidref ref="WorldSolid"/>
      <physvol name="TargetPlacement">
        <volumeref ref="Target"/>
        <positionref ref="Origin"/>
      </physvol>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
